{
  "name": "@tickover/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "prebuild": "pnpm --filter @tickover/contract build",
    "build": "vite build && tsx scripts/postbuild.ts",
    "pretest": "pnpm --filter @tickover/contract build && pnpm run build",
    "test": "vitest run",
    "e2e": "playwright test",
    "pretypecheck": "pnpm --filter @tickover/contract build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "preview": "tsx e2e/static-server.ts",
    "favicon": "tsx scripts/make-favicon.ts",
    "preog": "pnpm --filter @tickover/contract build",
    "og": "tsx scripts/make-og.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@analogjs/router": "^2.7.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tickover/contract": "workspace:*",
    "@tickover/ui": "workspace:*",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.0",
    "@analogjs/storybook-angular": "2.7.2",
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular/animations": "22.1.5",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/angular": "^10.6.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.2.0",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^22.0.0",
    "lighthouse": "^13.5.0",
    "storybook": "^10.6.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
