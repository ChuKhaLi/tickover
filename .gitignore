.worktrees/
.superpowers/
node_modules/
dist/
coverage/
.env
# deploy/build.env holds the VITE_* values baked into the web image. Not secrets, but
# per-environment, and a staging value committed here would ship to production.
build.env
*.log
test-results/
playwright-report/
# `pnpm --filter tickover-vscode package` writes the .vsix beside package.json, and
# nothing removed it: the next `git add -A` would commit a 29 KB build artifact.
*.vsix
blob-report/
out-tsc/
# `claude -p /plugin-types` writes these for packages/plugin's test:mod; they list this machine's
# own MCP tools and change with every Claude Code release. `**/` is required: a pattern with a
# slash anywhere but the end is anchored to the directory holding this .gitignore (the repo root),
# and these are written under packages/plugin/, not there.
**/.claude/types/
# Storybook's build output. `build-storybook` writes it beside package.json, the
# same trap the .vsix line above records.
storybook-static/
# `pnpm --filter @tickover/web lighthouse` writes the raw per-run JSON reports here, beside
# package.json. Not the gate's verdict -- that is stdout -- just the evidence, and it is large
# and per-machine.
lighthouse-results/

# Playwright MCP session artefacts (page snapshots, console logs)
.playwright-mcp/

# Agent worktrees. These are real `git worktree` checkouts of this repository, so each one holds a
# `.git` file and reads to the outer repo as an embedded repository: `git add -A` commits it as a
# gitlink, which happened once (amended out of 0fc5b9d). `.worktrees/` above is a different path;
# this is where the worktree tooling actually puts them. Anchored to the repo root by the slash in
# the middle, the same rule the `**/.claude/types/` note above records.
.claude/worktrees/

# Outreach redesign screenshots contain real prospect names (2026-09-29-tickover-ui)
docs/superpowers/reports/2026-09-29-tickover-ui/*.png
